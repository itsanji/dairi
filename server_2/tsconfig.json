{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [
			"bun-types"
		],
		"lib": [
			"ESNext"
		],
		"skipLibCheck": true,
		"strict": true,
		"strictPropertyInitialization": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"baseUrl": "."
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules"
	]
}